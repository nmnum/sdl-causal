data/raw/
data/external/
*.csv.gz
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.feather
*.arrow

# Olympus dataset CSVs downloaded from GitHub (reproduced by setup script).
# Exception: small reference tables committed intentionally should be
# force-added with `git add -f`.
data/olympus/

# ── Simulation outputs ────────────────────────────────────────────────────────
# Large campaign result DataFrames — regenerated by running the simulator.
results/campaigns/
results/tmp/
*.campaign.parquet
*.campaign.csv

# Keep benchmark summary figures and markdown docs in version control.
# (uc1_bo_vs_random_benchmark.png / .svg are small and informative.)

# ── Figures (intermediate / scratch) ─────────────────────────────────────────
# Scratch figures in tmp/ subdirectories are not tracked.
results/tmp/
figures/tmp/
*_scratch.*
*_draft.*

